# ── GitHub ────────────────────────────────────────────────────────────────────
# Required. Get yours at: https://github.com/settings/tokens
# Scopes needed: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=ghp_your_token_here

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Where to persist the vector DB on disk.
CHROMA_PERSIST_DIR=./chroma_db

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: cerebras | openai | anthropic | ollama | groq | gemini
# Default: cerebras (fastest, free tier available)
LLM_PROVIDER=cerebras

# Model name for your chosen provider. Examples:
#   cerebras  → llama3.1-8b  (free) or gpt-oss-120b (paid)
#   openai    → gpt-5
#   anthropic → claude-sonnet-4-6
#   ollama    → qwen2.5:7b  or llama3.2 (must be pulled locally first)
#   groq      → llama-3.3-70b-versatile  or llama-3.1-8b-instant
#   gemini    → gemini-2.5-flash
LLM_MODEL=llama3.1-8b

# ── API Key ───────────────────────────────────────────────────────────────────
# Universal key — works with any provider. Switch LLM_PROVIDER without changing this.
LLM_API_KEY=your_api_key_here

# Optional: provider-specific overrides (if you have multiple keys and want to be explicit)
# CEREBRAS_API_KEY=...   # https://cloud.cerebras.ai
# OPENAI_API_KEY=...     # https://platform.openai.com
# ANTHROPIC_API_KEY=...  # https://console.anthropic.com
# GROQ_API_KEY=...       # https://console.groq.com/keys
# GEMINI_API_KEY=...     # https://aistudio.google.com

# ── Ollama only ───────────────────────────────────────────────────────────────
# Only needed if LLM_PROVIDER=ollama and Ollama is not on the default port.
# LLM_BASE_URL=http://localhost:11434/v1

# ── Telemetry (optional) ───────────────────────────────────────────────────────
# Anonymous startup ping so the server admin can count total users across all
# connection modes (Render, uvx, pipx). No PII is ever sent — only a hashed
# machine fingerprint.
# Set TELEMETRY_ENDPOINT to your Render URL to enable counting for uvx/pipx users.
# Render users are always counted (they connect to your server directly).
# Git clone users are tracked via the GitHub Traffic Insights page instead.
TELEMETRY=true
# TELEMETRY_ENDPOINT=https://YOUR-SERVICE.onrender.com
