# ── GitHub ────────────────────────────────────────────────────────────────────
# Required. Get yours at: https://github.com/settings/tokens
# Scopes needed: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=ghp_your_token_here

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Where to persist the vector DB on disk.
CHROMA_PERSIST_DIR=./chroma_db

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: cerebras | openai | anthropic | ollama | groq | gemini
# Default: cerebras (fastest, free tier available)
LLM_PROVIDER=cerebras

# Model name for your chosen provider. Examples:
#   cerebras  → llama3.1-8b  (free) or llama3.1-70b (paid)
#   openai    → gpt-4o-mini  or gpt-4o
#   anthropic → claude-3-5-haiku-20241022  or claude-3-5-sonnet-20241022
#   ollama    → llama3.2  or mistral (must be pulled locally first)
#   groq      → llama-3.1-8b-instant  or mixtral-8x7b-32768  (free tier)
#   gemini    → gemini-1.5-flash  or gemini-1.5-pro  (free tier available)
LLM_MODEL=llama3.1-8b

# ── API Key ───────────────────────────────────────────────────────────────────
# Universal key — works with any provider. Switch LLM_PROVIDER without changing this.
LLM_API_KEY=your_api_key_here

# Optional: provider-specific overrides (if you have multiple keys and want to be explicit)
# CEREBRAS_API_KEY=...   # https://cloud.cerebras.ai
# OPENAI_API_KEY=...     # https://platform.openai.com
# ANTHROPIC_API_KEY=...  # https://console.anthropic.com
# GROQ_API_KEY=...       # https://console.groq.com/keys
# GEMINI_API_KEY=...     # https://aistudio.google.com

# ── Ollama only ───────────────────────────────────────────────────────────────
# Only needed if LLM_PROVIDER=ollama and Ollama is not on the default port.
# LLM_BASE_URL=http://localhost:11434/v1
