# ── GitHub App Device Flow (official local v0.3 release) ──────────────────────
# Regular users do not create an App or paste a GitHub token. The official
# package bundles the product App's public Client ID; browser approval stores the
# generated credential in the operating-system vault.
#
# Maintainers of a fork or an unreleased source checkout may temporarily override
# the bundled public App metadata here. These are public identifiers, not secrets.
# GITHUB_APP_CLIENT_ID=Iv1_your_maintainer_app_client_id
# GITHUB_APP_SLUG=your-github-app-slug
# Optional local vault profile; use different names only for separate local accounts.
# GITHUB_CREDENTIAL_PROFILE=default
#
# Never put a GitHub App client secret or private key in this local MCP config.
# GITHUB_APP_CLIENT_SECRET=   # rejected intentionally
# GITHUB_APP_PRIVATE_KEY=     # rejected intentionally
#
# GITHUB_TOKEN is not used by the v0.3 local flow. Do not add a personal token.

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Where to persist the vector DB on disk.
CHROMA_PERSIST_DIR=./chroma_db

# ── Namespace (optional) ──────────────────────────────────────────────────────
# Default namespace for indexing if none is provided.
# MCP_NAMESPACE=my-team

# ── Telemetry (optional) ───────────────────────────────────────────────────────
# Anonymous startup ping so the server admin can count total users across all
# connection modes (Render, uvx, pipx). No PII is ever sent — only a hashed
# machine fingerprint.
# Optional, disabled by default. Enable only with an endpoint you control.
TELEMETRY=false
# TELEMETRY_ENDPOINT=https://YOUR-SERVICE.onrender.com
